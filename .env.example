POSTGRES_DB=bank
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=5433
POSTGRES_HEALTH_INTERVAL=3s
POSTGRES_HEALTH_TIMEOUT=3s
POSTGRES_HEALTH_RETRIES=20

KAFKA_EXTERNAL_PORT=9092
KAFKA_INTERNAL_PORT=29092
KAFKA_CONTROLLER_PORT=29093
KAFKA_NODE_ID=1
KAFKA_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_INIT_RETRY_INTERVAL_SECONDS=2
KAFKA_BROKERS=localhost:9092
KAFKA_RATE_UPDATES_TOPIC=rate-updates
KAFKA_UPDATES_CONSUMER_GROUP=bank-service
KAFKA_DIAL_TIMEOUT=10s
KAFKA_REQUEST_TIMEOUT_OVERHEAD=10s

GRPC_RATES_HOST_PORT=9090
GRPC_RATES_INTERNAL_PORT=9090
GRPC_ADDR=:9090
GRPC_RATES_TARGET=localhost:9090
GRPC_REQUEST_TIMEOUT=3s
GRPC_SHUTDOWN_TIMEOUT=10s

HTTP_HOST_PORT=8080
HTTP_ADDR=:8080
HTTP_HANDLER_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_REQUEST_BODY_LIMIT=1048576

DATABASE_URL=postgres://postgres:postgres@localhost:5433/bank?sslmode=disable
DATABASE_CONNECT_TIMEOUT=10s
DATABASE_MIGRATION_TIMEOUT=30s
MIGRATIONS_PATH=migrations

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION=1h
RATE_TTL=30s
PAGINATION_DEFAULT_PAGE_SIZE=20
PAGINATION_MAX_PAGE_SIZE=100
PASSWORD_HASH_COST=10
USER_MIN_AGE=1
USER_MAX_AGE=150
MONEY_SCALE=2

TRANSFER_COMMISSION_OWN=0
TRANSFER_COMMISSION_FRIEND=0.03
TRANSFER_COMMISSION_DEFAULT=0.10

BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=password
BOOTSTRAP_ADMIN_FIRST_NAME=Evgeny
BOOTSTRAP_ADMIN_LAST_NAME=Pakhomov
BOOTSTRAP_ADMIN_AGE=20
BOOTSTRAP_ADMIN_GENDER=MALE

RATE_UPDATE_INTERVAL=1s
RATE_PUBLISH_INTERVAL=60s
BASE_RATES=USD:70,EUR:80
RATE_JITTER_MIN=0.95
RATE_JITTER_MAX=1.05
RATE_SCALE=2
